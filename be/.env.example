# Local backend — copy to .env.local (Convex's own convention) and fill in.
# Self-hosted deploy env (docker-compose, function-scope sync via
# scripts/sync-convex-env.mjs) is Phase 0 §1.1.8 — not built yet.

# Used by `bun run dev`; the Convex CLI persists the selected deployment here.
LAW_CONVEX_PORT=3212
LAW_CONVEX_SITE_PORT=3213
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Set by the @convex-dev/auth setup CLI (`npx @convex-dev/auth`).
JWT_PRIVATE_KEY=
JWKS=

# S3 storage (documents, uploads) — Phase 0 §1.1.8 / M1 documents.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SES email.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=

# Optional Google sign-in (must match the frontend OAuth client ID).
AUTH_GOOGLE_ID=

# AI Assistant (M4) — per-firm metered usage via OpenRouter + Gemini Live.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_TOKEN_SESSION_TTL_MS=68400000
GEMINI_LIVE_TOKEN_NEW_SESSION_TTL_MS=68400000
GEMINI_LIVE_TOKEN_USES=0
