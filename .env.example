# Root stack launcher ports.
LAW_FE_DEV_PORT=3000
LAW_FE_PREVIEW_PORT=4300
LAW_CONVEX_PORT=3212
LAW_CONVEX_SITE_PORT=3213

# Optional: cap concurrent checker processes on constrained machines.
LAW_CHECK_CONCURRENCY=

# Root `bun run dev` and `bun run preview` default to an anonymous local Convex
# deployment so a Convex account is not required.
CONVEX_AGENT_MODE=anonymous
